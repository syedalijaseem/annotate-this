{
  "name": "annotate-this-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Framework-agnostic image and video annotation library (workspace root).",
  "license": "MIT",
  "author": "Syed Ali Jaseem <syedali0057@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedalijaseem/annotate-this.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --ignore-pattern docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "pnpm -r check:package",
    "check:size": "pnpm -r check:size",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm check:package && pnpm check:size && pnpm check:licenses",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
