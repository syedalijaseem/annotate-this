{
  "name": "annotate-this-core",
  "version": "0.0.1",
  "description": "Framework-agnostic, DOM-free core of annotate-this: document model, operations, store, undo and tools.",
  "license": "MIT",
  "author": "Syed Ali Jaseem <syedali0057@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedalijaseem/annotate-this.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/syedalijaseem/annotate-this#readme",
  "keywords": [
    "annotation",
    "image-annotation",
    "labeling",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:size": "size-limit",
    "coverage": "vitest run --coverage",
    "test:csp": "node --disallow-code-generation-from-strings ./node_modules/vitest/vitest.mjs run"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "25 kB",
      "gzip": true,
      "ignore": [
        "valibot"
      ]
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/esbuild": "^14.2.0",
    "@size-limit/file": "^14.2.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitest/coverage-v8": "5.0.5",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tsdown": "^0.23.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
